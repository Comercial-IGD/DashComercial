# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Service account do Google (Sheets API) — usada só pela rota /api/sync, nunca no browser
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Segredo para autorizar chamadas a /api/sync — o Vercel Cron envia
# automaticamente "Authorization: Bearer $CRON_SECRET" quando esta env var existe.
CRON_SECRET=
